FROM ruby:3.4.11

ENV LANG=C.UTF-8
ENV TZ=Asia/Tokyo

RUN apt-get update -qq \
    && apt-get install --no-install-recommends -y \
       build-essential \
       libpq-dev \
       git \
       chromium \
       chromium-driver \
       fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /myapp