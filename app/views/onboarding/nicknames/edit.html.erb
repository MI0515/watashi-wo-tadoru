<% content_for :title, "呼ばれ方の設定 | わたしを辿る" %>

<div id="watashi-wo-tadoru-signup">
  <div class="page">
    <header class="header wtc-header">
      <%= link_to "わたしを辿る", root_path, class: "brand" %>
      <%= button_to "ログアウト", destroy_user_session_path,
                    method: :delete, class: "back-link" %>
    </header>

    <div class="main">
      <section class="card" aria-labelledby="nickname-title">
        <p class="eyebrow">初期設定 1 / 3</p>
        <h1 id="nickname-title">呼ばれ方を決めよう</h1>
        <p class="lead">
          ミツメイトがあなたを呼ぶときの名前です。<br>
          あとから設定画面で変更できます。
        </p>

        <%= form_with model: @user,
                      url: onboarding_nickname_path,
                      method: :patch,
                      data: { controller: "nickname-preview" } do |f| %>
          <% if @user.errors.any? %>
            <div id="error_explanation" role="alert">
              <h2>入力内容を確認してください</h2>
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="field">
            <%= f.label :nickname, "ニックネーム" %>
            <%= f.text_field :nickname,
                  autofocus: true,
                  required: true,
                  maxlength: 20,
                  autocomplete: "nickname",
                  placeholder: "例：かわいこ",
                  data: {
                    nickname_preview_target: "nickname",
                    action: "input->nickname-preview#update"
                  } %>
            <p class="hint">20文字以内で入力してください</p>
          </div>

          <div class="field">
            <%= f.label :honorific, "呼び方（敬称など）" %>
            <%= f.text_field :honorific,
                  maxlength: 10,
                  placeholder: "例：さん／くん／ちゃん",
                  data: {
                    nickname_preview_target: "honorific",
                    action: "input->nickname-preview#update"
                  } %>
            <p class="hint">
              10文字以内。ニックネームだけで呼ばれたい場合は空欄にしてください
            </p>
          </div>

          <div class="preview-box" aria-live="polite">
            <span class="preview-label">ミツメイトからは、こう呼ばれます</span>
            <span class="preview-name">
              「<span data-nickname-preview-target="preview"><%= @user.nickname.presence || "ニックネーム" %><%= @user.honorific %></span>」
            </span>
          </div>

          <p class="hint setup-note">
            入力したニックネームと呼び方は、そのまま続けて表示されます。
            「さん」などを付けて呼ばれたい場合は、呼び方の欄へ入力してください。
          </p>

          <%= f.submit "次へ：16タイプを選ぶ", class: "submit" %>
        <% end %>
      </section>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>