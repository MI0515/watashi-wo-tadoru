<% content_for :title, "新しいパスワードの設定 | わたしを辿る" %>

<div id="watashi-wo-tadoru-signup">
  <div class="page">
    <header class="header wtc-header">
      <%= link_to "わたしを辿る", root_path, class: "brand" %>
      <%= link_to "← トップへ戻る", root_path, class: "back-link" %>
    </header>

    <div class="main">
      <section class="card" aria-labelledby="new-password-title">
        <p class="eyebrow">もう一度、ここから</p>
        <h1 id="new-password-title">
          <span class="wtc-phrase">新しいパスワードを</span><span class="wtc-phrase">設定</span>
        </h1>
        <p class="lead">
          <span class="wtc-phrase">これから使用するパスワードを</span><span class="wtc-phrase">入力してください。</span>
        </p>

        <%= form_for(resource, as: resource_name,
                     url: password_path(resource_name),
                     html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages",
                     resource: resource,
                     heading: "パスワードを変更できませんでした。" %>
          <%= f.hidden_field :reset_password_token %>

          <div class="field">
            <%= f.label :password, "新しいパスワード" %>
            <%= f.password_field :password,
                  autofocus: true,
                  autocomplete: "new-password",
                  placeholder: "新しいパスワードを入力",
                  minlength: @minimum_password_length,
                  maxlength: resource_class.password_length.max,
                  required: true %>
            <p class="hint">
              <%= @minimum_password_length %>文字以上で入力してください
            </p>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
            <%= f.password_field :password_confirmation,
                  autocomplete: "new-password",
                  placeholder: "もう一度入力",
                  required: true %>
          </div>

          <%= f.submit "パスワードを変更", class: "submit" %>
        <% end %>

        <p class="login-link">
          <%= link_to "← ログイン画面へ戻る", new_user_session_path %>
        </p>
      </section>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>
