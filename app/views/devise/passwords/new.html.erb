<% content_for :title, "パスワード再設定 | わたしを辿る" %>

<div id="watashi-wo-tadoru-signup">
  <div class="page">
    <header class="header wtc-header">
      <%= link_to "わたしを辿る", root_path, class: "brand" %>
      <%= link_to "← トップへ戻る", root_path, class: "back-link" %>
    </header>

    <div class="main">
      <section class="card" aria-labelledby="reset-title">
        <p class="eyebrow">パスワードをお忘れの方へ</p>
        <h1 id="reset-title">パスワードを再設定</h1>
        <p class="lead">
          登録したメールアドレスへ、<br>
          <span class="wtc-phrase">再設定のための案内を</span><span class="wtc-phrase">お送りします。</span>
        </p>

        <%= form_for(resource, as: resource_name,
                     url: password_path(resource_name),
                     html: { method: :post }) do |f| %>
          <%= render "devise/shared/error_messages",
                     resource: resource,
                     heading: "再設定用メールを送信できませんでした。" %>

          <div class="field">
            <%= f.label :email, "メールアドレス" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "example@email.com",
                  required: true %>
          </div>

          <%= f.submit "再設定用メールを送る", class: "submit" %>
        <% end %>

        <p class="login-link">
          <%= link_to "← ログイン画面へ戻る", new_user_session_path %>
        </p>
      </section>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>
