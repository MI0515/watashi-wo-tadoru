<% content_for :title, "ログイン | わたしを辿る" %>

<div id="watashi-wo-tadoru-signup">
  <div class="page">
    <header class="header wtc-header">
      <%= link_to "わたしを辿る", root_path, class: "brand" %>
      <%= link_to "← トップへ戻る", root_path, class: "back-link" %>
    </header>

    <div class="main">
      <section class="card" aria-labelledby="login-title">
        <p class="eyebrow">おかえりなさい</p>
        <h1 id="login-title">ログイン</h1>
        <p class="lead">
          <span class="wtc-phrase">また、自分の気持ちを</span><span class="wtc-phrase">ゆっくり辿っていきましょう。</span>
        </p>

        <%= form_for(resource, as: resource_name,
                     url: session_path(resource_name)) do |f| %>
          <div class="field">
            <%= f.label :email, "メールアドレス" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "example@email.com",
                  required: true %>
          </div>

          <div class="field">
            <%= f.label :password, "パスワード" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  placeholder: "パスワードを入力",
                  required: true %>
          </div>

          <%# パスワード再設定へのリンクは#17で接続する %>
          <p class="forgot-link">
            <button type="button" disabled>
              パスワードを忘れた方はこちら（準備中）
            </button>
          </p>

          <%= f.submit "ログイン", class: "submit" %>
        <% end %>

        <p class="login-link">
          アカウントをお持ちでない方
          <%= link_to "新規登録", new_user_registration_path %>
        </p>
      </section>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>
