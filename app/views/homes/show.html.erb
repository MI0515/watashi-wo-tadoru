<% content_for :title, "ホーム | わたしを辿る" %>

<div id="watashi-dialogue-response-states" data-screen="home">
  <header class="header wtc-header">
    <%= link_to "わたしを辿る", home_path, class: "brand" %>
    <%= button_to "ログアウト", destroy_user_session_path,
                  method: :delete, class: "wtc-link" %>
  </header>

  <% if current_user.onboarding_completed_at.nil? %>
    <%= render "guide" %>
  <% end %>

  <div class="stage">
    <% if @companion %>
      <%= tag.div class: "character",
                  data: {
                    controller: "monologue",
                    monologue_contents_value: @monologues.map(&:content)
                  } do %>
        <% if @monologue %>
          <p class="quote"
             aria-live="polite"
             data-monologue-target="quote"><%= @monologue.content %></p>
        <% end %>

        <button type="button"
                class="monologue-button"
                aria-label="独り言を切り替える"
                data-action="click->monologue#change">
          <%= image_tag @companion.sd_image_path,
                        alt: "選択中のミツメイト", class: "sd-mate" %>
        </button>
      <% end %>
    <% end %>

    <section class="panel home-panel" aria-labelledby="home-title">
      <h1 id="home-title" class="sr-only">ホーム</h1>

      <p class="hello">
        <%= @display_name ? "おかえり、#{@display_name}。" : "おかえりなさい。" %>
      </p>

      <div class="home-actions">
        <p>少し立ち止まって、自分の気持ちを辿ってみる？</p>
        <div class="actions">
          <%= link_to "振り返りを始める", new_reflection_path, class: "primary" %>
          <button type="button" class="secondary" disabled>記録を見る</button>
        </div>
      </div>
    </section>
  </div>

  <%= render "shared/footer" %>
</div>