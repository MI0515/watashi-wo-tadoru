# Bundlerのローカル設定
/.bundle

# 秘密鍵・環境変数
/config/master.key
/config/credentials/*.key
.env
.env.*
!.env.example

# ログ・一時ファイル
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# ローカルの保存データ
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# 生成物・依存パッケージ
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# OS固有ファイル
.DS_Store

# テスト実行で生成されるカバレッジレポート
/coverage/
